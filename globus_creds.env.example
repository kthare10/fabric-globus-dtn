# Copy to globus_creds.env (chmod 600) and fill in. Never commit the real file.
#
# A Globus service credential for Globus Connect Server:
#   app.globus.org > Settings > Developers > (your project) >
#   "Register a service account / application credential for Globus Connect Server"
# The secret is shown once, normally 44 characters ending in '='.
GCS_CLI_CLIENT_ID=00000000-0000-0000-0000-000000000000
GCS_CLI_CLIENT_SECRET=
